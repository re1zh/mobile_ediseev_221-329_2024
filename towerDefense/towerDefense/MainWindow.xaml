<Window x:Class="towerDefense.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:towerDefense"
        mc:Ignorable="d"
        Title="TowerDefense" Height="530" Width="985"
        WindowStartupLocation="CenterScreen">
    
    <Grid Background="LightGray">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="735"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="LightGray" Margin="10">
            <TextBlock Text="📊 СТАТИСТИКА" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

            <TextBlock Text="💰 Деньги:" FontSize="16"/>
            <TextBlock Name="MoneyTextBlock" Text="40" FontSize="16" FontWeight="Bold" Margin="0,0,0,5"/>

            <TextBlock Text="⏳ Время:" FontSize="16"/>
            <TextBlock Name="TimerTextBlock" Text="60" FontSize="16" FontWeight="Bold" Margin="0,0,0,5"/>

            <TextBlock Text="🔥 Уровень сложности:" FontSize="16"/>
            <TextBlock Name="DifficultyTextBlock" Text="1" FontSize="16" FontWeight="Bold" Margin="0,0,0,5"/>

            <TextBlock Text="🏰 Количество башен:" FontSize="16"/>
            <TextBlock Name="TowerCountTextBlock" Text="0" FontSize="16" FontWeight="Bold" Margin="0,0,0,5"/>

            <TextBlock Text="🏰 Выберите башню:" FontSize="16" Margin="0,0,0,5"/>

            <Button Name="ArcherTowerButton" Content="🏹 Стрелковая (10)" Width="200" FontSize="14" Margin="0,5,0,5" Click="SelectArcherTower"/>
            <Button Name="CannonTowerButton" Content="💣 Пушечная (20)" Width="200" FontSize="14" Margin="0,5,0,5" Click="SelectCannonTower"/>
            <Button Name="IceTowerButton" Content="❄️ Ледяная (15)" Width="200" FontSize="14" Margin="0,5,0,5" Click="SelectFrostTower"/>

            <Button Content="Выйти в меню" 
                    Width="200"
                    Height="50"
                    FontSize="16" 
                    Margin="0,50,0,0" 
                    Click="ExitButton_Click"/>
        </StackPanel>

        <Canvas Name="GameCanvas" Background="Black" Grid.Column="1" Margin="0">
                
        </Canvas>

        <TextBlock Name="CountdownText"
            Text=""
            FontSize="72"
            FontWeight="Bold"
            Foreground="White"
            Opacity="0.8"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="Hidden"/>   
    </Grid>
</Window>
