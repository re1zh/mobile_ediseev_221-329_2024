<Window x:Class="towerDefense.About"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:towerDefense"
        mc:Ignorable="d"
        Title="TowerDefense" Height="440" Width="985"
        WindowStartupLocation="CenterScreen">
    <Grid Background="LightGray">
        <TextBlock
                FontSize="24"
                TextWrapping="Wrap"
                Width="600"
                Margin="20"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                TextAlignment="Center">
            Проект разработан в рамках дисциплины<LineBreak/>
            'Разработка мобильных приложений' <LineBreak/>
            студентом группы 221-329<LineBreak/>
            Едисеевым Олегом Владимировичем <LineBreak/>
            Индивидуальный проект - Игра "TowerDefense"
            
        </TextBlock>

        <Button Content="Назад"
                Width="200"
                Height="50"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Margin="0,0,0,20"
                FontSize="20"
                Click="BackButton_Click"/>
    </Grid>
</Window>
