<Window x:Class="towerDefense.LevelSelection"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:towerDefense"
        mc:Ignorable="d"
        Title="TowerDefense" Height="530" Width="985"
        WindowStartupLocation="CenterScreen">
    <Grid Background="LightGray">
        <StackPanel Background="LightGray" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center">
            <Button 
                Content="Уровень 1: Змейка"
                Width="400" 
                Height="50" 
                Margin="0,10,0,0"
                FontSize="20"
                Click="Level1Button_Click"/>
            <Button 
                Content="Уровень 2: Спираль" 
                Width="400" 
                Height="50" 
                Margin="0,10,0,0"
                FontSize="20"
                Click="Level2Button_Click"/>
            <Button 
                Content="Уровень 3: Тоге" 
                Width="400" Height="50" 
                Margin="0,10,0,0"
                FontSize="20"
                Click="Level3Button_Click"/>
            <Button 
                Content="Назад" 
                Width="200" 
                Height="50" 
                Margin="0,20,0,0"
                FontSize="20"
                Click="BackButton_Click"/>
        </StackPanel>
        
    </Grid>
</Window>
